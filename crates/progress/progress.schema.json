{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plinth project progress source",
  "description": "One progress document, newest release first. plinth-progress additionally enforces version uniqueness and ordering, real calendar dates and non-increasing dates; this schema covers the structural rules an editor can check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "entries"],
  "properties": {
    "title": { "$ref": "#/$defs/text" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S",
      "description": "Plain text with `code` and [links](https://example.com); rendered as text, never markup. Must not be empty or whitespace-only."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-((0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "Canonical SemVer without a leading `v`. Entry versions are unique as exact strings and ordered strictly descending by SemVer precedence; build metadata is preserved but ignored for precedence."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Quoted date. plinth-progress rejects impossible calendar dates and dates later than the preceding entry's; same-day entries are allowed."
    },
    "status": {
      "enum": ["done", "in_progress", "blocked", "planned", "dropped"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "summary",
        "milestones",
        "done",
        "next",
        "risks",
        "sections"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "date": { "$ref": "#/$defs/date" },
        "summary": { "$ref": "#/$defs/text" },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        },
        "done": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "next": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "body"],
      "properties": {
        "heading": { "$ref": "#/$defs/text" },
        "body": { "$ref": "#/$defs/text" }
      }
    }
  }
}
